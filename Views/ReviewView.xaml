<UserControl
    x:Class="RecordThis.Views.ReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RecordThis.Views"
    xmlns:models="using:RecordThis.Models">

    <UserControl.Resources>
        <DataTemplate x:Key="ExportChoiceTemplate" x:DataType="models:ExportChoice">
            <TextBlock Text="{x:Bind Label}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600" Padding="24,4,24,24" Spacing="16">

            <!-- Playback preview + trimming -->
            <Border Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{x:Bind ViewModel.DetailsText, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid Height="112">
                            <local:WaveformView
                                MinimumSelection="{x:Bind ViewModel.MinimumSelection, Mode=OneWay}"
                                Progress="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                SeekCommand="{x:Bind ViewModel.SeekCommand}"
                                TrimEnd="{x:Bind ViewModel.TrimEnd, Mode=TwoWay}"
                                TrimStart="{x:Bind ViewModel.TrimStart, Mode=TwoWay}"
                                Waveform="{x:Bind ViewModel.Waveform, Mode=OneWay}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Drawing waveform…" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{x:Bind ViewModel.TrimText, Mode=OneWay}" />
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button MinWidth="96"
                                AutomationProperties.Name="{x:Bind ViewModel.PlayPauseText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PlayPauseCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.PlayPauseText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.TrimSilenceCommand}"
                                ToolTipService.ToolTip="Move the handles to where the sound starts and ends">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8C6;" />
                                <TextBlock Text="Trim silence" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                AutomationProperties.Name="Reset trim"
                                Command="{x:Bind ViewModel.ResetTrimCommand}"
                                ToolTipService.ToolTip="Reset trim"
                                Visibility="{x:Bind ViewModel.IsTrimmed, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                        </Button>

                        <StackPanel Grid.Column="3"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Orientation="Horizontal" Spacing="4">
                            <TextBlock Typography.NumeralAlignment="Tabular" Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="/" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Typography.NumeralAlignment="Tabular"
                                       Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Export -->
            <Border Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="FormatCombo"
                                  HorizontalAlignment="Stretch"
                                  Header="Format"
                                  IsEnabled="{x:Bind local:XBind.Not(ViewModel.IsExporting), Mode=OneWay}"
                                  ItemTemplate="{StaticResource ExportChoiceTemplate}"
                                  ItemsSource="{x:Bind ViewModel.FormatChoices}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=OneWay}"
                                  SelectionChanged="OnFormatChanged" />

                        <ComboBox x:Name="SampleRateCombo"
                                  Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  Header="Sample rate"
                                  IsEnabled="{x:Bind local:XBind.Not(ViewModel.IsExporting), Mode=OneWay}"
                                  ItemTemplate="{StaticResource ExportChoiceTemplate}"
                                  ItemsSource="{x:Bind ViewModel.SampleRateChoices}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSampleRate, Mode=OneWay}"
                                  SelectionChanged="OnSampleRateChanged" />

                        <!-- WAV: bit depth. MP3: bit rate. -->
                        <ComboBox x:Name="BitDepthCombo"
                                  Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  Header="Bit depth"
                                  IsEnabled="{x:Bind local:XBind.Not(ViewModel.IsExporting), Mode=OneWay}"
                                  ItemTemplate="{StaticResource ExportChoiceTemplate}"
                                  ItemsSource="{x:Bind ViewModel.BitDepthChoices}"
                                  SelectedItem="{x:Bind ViewModel.SelectedBitDepth, Mode=OneWay}"
                                  SelectionChanged="OnBitDepthChanged"
                                  Visibility="{x:Bind ViewModel.IsWav, Mode=OneWay}" />
                        <ComboBox x:Name="BitRateCombo"
                                  Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  Header="Quality"
                                  IsEnabled="{x:Bind local:XBind.Not(ViewModel.IsExporting), Mode=OneWay}"
                                  ItemTemplate="{StaticResource ExportChoiceTemplate}"
                                  ItemsSource="{x:Bind ViewModel.BitRateChoices}"
                                  SelectedItem="{x:Bind ViewModel.SelectedBitRate, Mode=OneWay}"
                                  SelectionChanged="OnBitRateChanged"
                                  Visibility="{x:Bind ViewModel.IsMp3, Mode=OneWay}" />
                    </Grid>

                    <ProgressBar Maximum="100"
                                 Value="{x:Bind ViewModel.ExportProgress, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Destructive: quiet outline that turns red on hover. Undo is offered afterwards. -->
                        <Button HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DiscardCommand}"
                                ToolTipService.ToolTip="Delete this recording (you can undo for 5 seconds)"
                                Visibility="{x:Bind ViewModel.HasUnsavedRecording, Mode=OneWay}">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SystemFillColorCriticalBrush" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock Text="Discard" />
                            </StackPanel>
                        </Button>

                        <Button HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DiscardCommand}"
                                Visibility="{x:Bind ViewModel.IsSaved, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE7C8;" />
                                <TextBlock Text="New recording" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CopyButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Copy MP3 to clipboard"
                                Command="{x:Bind ViewModel.CopyCommand}"
                                ToolTipService.ToolTip="Copy as an MP3 to paste into Discord, WhatsApp and other apps (Ctrl+C)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="C" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                <TextBlock Text="Copy MP3" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="SaveButton"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.SaveCommand}"
                                ToolTipService.ToolTip="Save to a file (Ctrl+S)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                <TextBlock Text="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status: copy/save results, recording warnings -->
            <InfoBar
                Closed="OnNoticeClosed"
                IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                Message="{x:Bind local:XBind.NoticeMessage(ViewModel.Notice), Mode=OneWay}"
                Severity="{x:Bind local:XBind.Severity(ViewModel.Notice), Mode=OneWay}"
                Title="{x:Bind local:XBind.NoticeTitle(ViewModel.Notice), Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.RunNoticeActionCommand}"
                            Content="{x:Bind local:XBind.NoticeActionText(ViewModel.Notice), Mode=OneWay}"
                            Visibility="{x:Bind local:XBind.HasAction(ViewModel.Notice), Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </ScrollViewer>
</UserControl>

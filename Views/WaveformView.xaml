<UserControl
    x:Class="RecordThis.Views.WaveformView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Waveform. Left and right arrows seek. Open and close square brackets set the trim start and end at the playhead."
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <Grid x:Name="Surface"
          Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
          CornerRadius="6"
          PointerCanceled="OnPointerReleased"
          PointerCaptureLost="OnPointerCaptureLost"
          PointerExited="OnPointerExited"
          PointerMoved="OnPointerMoved"
          PointerPressed="OnPointerPressed"
          PointerReleased="OnPointerReleased"
          SizeChanged="OnSurfaceSizeChanged">

        <!-- Played portion tint -->
        <Rectangle x:Name="PlayedOverlay"
                   Width="0"
                   HorizontalAlignment="Left"
                   Fill="{ThemeResource AccentFillColorDefaultBrush}"
                   Opacity="0.12" />

        <Line x:Name="CenterLine"
              VerticalAlignment="Center"
              Opacity="0.4"
              Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
              StrokeThickness="1"
              X1="0" X2="0" Y1="0" Y2="0" />

        <!-- Symmetric peak envelope -->
        <Polygon x:Name="Envelope" Fill="{ThemeResource AccentFillColorDefaultBrush}" />

        <!-- Trimmed-away regions are dimmed -->
        <Rectangle x:Name="LeftShade"
                   Width="0"
                   HorizontalAlignment="Left"
                   Fill="{ThemeResource SmokeFillColorDefaultBrush}" />
        <Rectangle x:Name="RightShade"
                   Width="0"
                   HorizontalAlignment="Right"
                   Fill="{ThemeResource SmokeFillColorDefaultBrush}" />

        <!-- Playhead -->
        <Rectangle x:Name="Playhead"
                   Width="2"
                   HorizontalAlignment="Left"
                   Fill="{ThemeResource TextFillColorPrimaryBrush}">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="PlayheadTransform" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- Trim handles: "[" at the start, "]" at the end -->
        <Border x:Name="StartHandle"
                Width="10"
                HorizontalAlignment="Left"
                BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                BorderThickness="3,3,0,3"
                CornerRadius="4,0,0,4"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="StartHandleTransform" />
            </Border.RenderTransform>
        </Border>
        <Border x:Name="EndHandle"
                Width="10"
                HorizontalAlignment="Left"
                BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                BorderThickness="0,3,3,3"
                CornerRadius="0,4,4,0"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="EndHandleTransform" />
            </Border.RenderTransform>
        </Border>
    </Grid>
</UserControl>

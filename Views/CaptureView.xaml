<UserControl
    x:Class="RecordThis.Views.CaptureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RecordThis.Views"
    xmlns:models="using:RecordThis.Models">

    <UserControl.Resources>
        <Style x:Key="KeycapStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeycapTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ShortcutLabelStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <!--
        Content is pinned to the window with fixed margins (no centring, no scroll viewer), and nothing
        on this screen changes size when recording starts, so the layout can't drift sideways.
    -->
    <Grid Padding="24,4,24,24">
        <StackPanel VerticalAlignment="Top" Spacing="16">

            <!-- Crash recovery: a spool from a previous session is still on disk -->
            <InfoBar
                Title="Unsaved recording found"
                IsClosable="False"
                IsOpen="{x:Bind local:XBind.IsNotNull(ViewModel.PendingRecovery), Mode=OneWay}"
                Visibility="{x:Bind local:XBind.VisibleIfNotNull(ViewModel.PendingRecovery), Mode=OneWay}"
                Message="{x:Bind ViewModel.RecoveryText, Mode=OneWay}"
                Severity="Warning">
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.RecoverCommand}" Content="Recover it"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Command="{x:Bind ViewModel.DiscardRecoveryCommand}" Content="Delete it" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- Errors and status (device lost, exclusive mode, privacy, ...) -->
            <InfoBar
                Closed="OnNoticeClosed"
                IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                Message="{x:Bind local:XBind.NoticeMessage(ViewModel.Notice), Mode=OneWay}"
                Severity="{x:Bind local:XBind.Severity(ViewModel.Notice), Mode=OneWay}"
                Title="{x:Bind local:XBind.NoticeTitle(ViewModel.Notice), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.RunNoticeActionCommand}"
                            Content="{x:Bind local:XBind.NoticeActionText(ViewModel.Notice), Mode=OneWay}"
                            Visibility="{x:Bind local:XBind.HasAction(ViewModel.Notice), Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="20">

                    <!-- Source: System audio (loopback) vs Microphone, then the device within that group -->
                    <StackPanel Spacing="8">
                    <SelectorBar x:Name="SourceTabs"
                                 Margin="-12,0,0,0"
                                 IsEnabled="{x:Bind ViewModel.CanChangeDevice, Mode=OneWay}"
                                 SelectionChanged="OnSourceTabChanged">
                        <SelectorBarItem x:Name="SystemAudioTab"
                                         Text="System audio"
                                         ToolTipService.ToolTip="Record everything a speaker or headphone output plays">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE767;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="MicrophoneTab"
                                         Text="Microphone"
                                         ToolTipService.ToolTip="Record from a microphone or other input">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE720;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                    <ComboBox
                        x:Name="SourceCombo"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Device"
                        IsEnabled="{x:Bind ViewModel.CanChangeDevice, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Devices}"
                        PlaceholderText="{x:Bind ViewModel.SourcePlaceholder, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=OneWay}"
                        SelectionChanged="OnSourceSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:AudioDeviceModel">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="{x:Bind Glyph}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Text="{x:Bind Subtitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    </StackPanel>

                    <!-- Live level meter -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Live level:" />
                                <TextBlock AutomationProperties.LiveSetting="Off"
                                           Typography.NumeralAlignment="Tabular"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind ViewModel.LevelText, Mode=OneWay}" />
                                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="CLIP"
                                           Visibility="{x:Bind ViewModel.IsClipping, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="{x:Bind ViewModel.ModeText, Mode=OneWay}" />
                        </Grid>

                        <Grid Height="10" AutomationProperties.Name="Live input level" CornerRadius="5">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0" Color="#FF2EA043" />
                                        <GradientStop Offset="0.7" Color="#FF2EA043" />
                                        <GradientStop Offset="0.85" Color="#FFE3B341" />
                                        <GradientStop Offset="1" Color="#FFE5484D" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Mask shrinks from the right as the level rises, so the gradient stays anchored to dBFS -->
                            <Rectangle Fill="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" RenderTransformOrigin="1,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{x:Bind ViewModel.MeterMask, Mode=OneWay}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <Grid>
                            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Text="-60 dB" />
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Text="0 dBFS" />
                        </Grid>

                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{x:Bind ViewModel.FormatText, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Start / stop, with the global shortcut right underneath -->
                    <StackPanel Spacing="10">
                    <Button HorizontalAlignment="Stretch"
                            MinHeight="48"
                            AutomationProperties.Name="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleRecordingCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="16" Glyph="{x:Bind local:XBind.RecordGlyph(ViewModel.IsRecording), Mode=OneWay}" />
                            <TextBlock Typography.NumeralAlignment="Tabular" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource KeycapStyle}">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="{x:Bind ViewModel.HotkeyGesture, Mode=OneWay}" />
                        </Border>
                        <TextBlock Style="{StaticResource ShortcutLabelStyle}" Text="{x:Bind ViewModel.HotkeyDescription, Mode=OneWay}" />
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Uses the space under the card: shortcuts for after you stop recording -->
            <StackPanel Padding="4,0" Spacing="8">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Text="After recording" />
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource KeycapStyle}">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="Ctrl+C" />
                        </Border>
                        <TextBlock Style="{StaticResource ShortcutLabelStyle}" Text="Copy as MP3" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource KeycapStyle}">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="Ctrl+S" />
                        </Border>
                        <TextBlock Style="{StaticResource ShortcutLabelStyle}" Text="Save to a file" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                        <Border Style="{StaticResource KeycapStyle}">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="[" />
                        </Border>
                        <Border Style="{StaticResource KeycapStyle}">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="]" />
                        </Border>
                        <TextBlock Margin="4,0,0,0" Style="{StaticResource ShortcutLabelStyle}" Text="Trim at the playhead" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Border Style="{StaticResource KeycapStyle}">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="←" />
                        </Border>
                        <Border Style="{StaticResource KeycapStyle}">
                            <TextBlock Style="{StaticResource KeycapTextStyle}" Text="→" />
                        </Border>
                        <TextBlock Margin="4,0,0,0" Style="{StaticResource ShortcutLabelStyle}" Text="Move the playhead" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

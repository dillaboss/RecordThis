import { Palette } from "std-widgets.slint";

// Windows 11 Fluent tokens (dark / light). The accent comes from the Windows accent color.
export global Theme {
    // 0 = follow Windows, 1 = light, 2 = dark (used by the screenshot tool).
    in property <int> scheme-override: 0;
    out property <bool> dark: scheme-override == 2 ? true : scheme-override == 1 ? false : Palette.color-scheme == ColorScheme.dark;

    // AccentLight2 is used on dark backgrounds, AccentDark1 on light ones (as WinUI does).
    in property <color> accent-on-dark: #4cc2ff;
    in property <color> accent-on-light: #005fb8;
    in property <color> text-on-accent-dark: #000000;
    in property <color> text-on-accent-light: #ffffff;
    out property <color> accent: dark ? accent-on-dark : accent-on-light;
    out property <color> on-accent: dark ? text-on-accent-dark : text-on-accent-light;
    out property <color> accent-hover: dark ? accent.with-alpha(0.9) : accent.with-alpha(0.9);
    out property <color> accent-pressed: accent.with-alpha(0.8);

    out property <color> window-bg: dark ? #202020 : #f3f3f3;
    out property <color> card-bg: dark ? #2b2b2b : #fbfbfb;
    out property <color> card-stroke: dark ? #1c1c1c : #e5e5e5;
    out property <color> control: dark ? #373737 : #ffffff;
    out property <color> control-hover: dark ? #3d3d3d : #f9f9f9;
    out property <color> control-pressed: dark ? #323232 : #f5f5f5;
    out property <color> control-disabled: dark ? #2f2f2f : #f5f5f5;
    out property <color> control-stroke: dark ? #434343 : #e5e5e5;
    out property <color> control-stroke-bottom: dark ? #3a3a3a : #cccccc;
    out property <color> subtle-hover: dark ? #ffffff10 : #0000000a;
    out property <color> subtle-pressed: dark ? #ffffff0b : #00000006;
    out property <color> inset: dark ? #1f1f1f : #f0f0f0;
    out property <color> divider: dark ? #ffffff14 : #0000000f;
    out property <color> popup-bg: dark ? #2c2c2c : #f9f9f9;
    out property <color> popup-stroke: dark ? #454545 : #dcdcdc;
    out property <color> smoke: dark ? #000000a6 : #ffffffb8;
    out property <color> scrim: #0000004d;

    out property <color> text: dark ? #ffffff : #1b1b1b;
    out property <color> text-secondary: dark ? #c5c5c5 : #5d5d5d;
    out property <color> text-tertiary: dark ? #9a9a9a : #8a8a8a;
    out property <color> text-disabled: dark ? #6e6e6e : #a6a6a6;

    out property <color> success: dark ? #6ccb5f : #0f7b0f;
    out property <color> caution: dark ? #fce100 : #9d5d00;
    out property <color> critical: dark ? #ff99a4 : #c42b1c;
    out property <color> record: #c42b1c;
    out property <color> record-hover: #d13b2c;
    out property <color> record-pressed: #b02618;
    out property <color> info-bg: dark ? #2f2f2f : #f6f6f6;
    out property <color> success-bg: dark ? #393d1b : #dff6dd;
    out property <color> caution-bg: dark ? #433519 : #fff4ce;
    out property <color> critical-bg: dark ? #442726 : #fde7e9;

    out property <color> meter-green: #3fb950;
    out property <color> meter-yellow: #e3b341;
    out property <color> meter-red: #f85149;

    out property <length> radius: 4px;
    out property <length> card-radius: 8px;
    out property <length> body: 14px;
    out property <length> caption: 12px;
    out property <length> title: 20px;
}

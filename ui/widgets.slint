import { Theme } from "theme.slint";

export enum BtnKind { standard, accent, subtle, stop }

export struct NoticeData {
    visible: bool,
    title: string,
    message: string,
    // 0 info, 1 success, 2 warning, 3 error
    severity: int,
    action-text: string,
    secondary-text: string,
    closable: bool,
}

export struct DeviceItem {
    name: string,
    subtitle: string,
}

// A focus ring drawn around keyboard-focused controls.
component FocusRing inherits Rectangle {
    border-width: 2px;
    border-color: Theme.text;
    border-radius: Theme.radius + 3px;
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <BtnKind> kind: BtnKind.standard;
    in property <bool> enabled: true;
    in property <string> shortcut;
    in property <length> icon-size: 16px;
    in property <length> font-size: Theme.body;
    in property <int> font-weight: 400;
    in property <length> pad: 12px;
    // Red text and border on hover: for destructive actions.
    in property <bool> danger: false;
    in property <string> trailing;
    in property <length> trailing-size: Theme.body;
    in property <string> tooltip;
    callback clicked();

    private property <bool> hover: ta.has-hover && root.enabled;
    private property <bool> down: ta.pressed && root.enabled;
    private property <bool> has-icon: root.icon.width > 0;
    private property <color> fg: !root.enabled ? Theme.text-disabled
        : root.kind == BtnKind.accent ? Theme.on-accent
        : root.kind == BtnKind.stop ? #ffffff
        : root.danger && root.hover ? Theme.critical
        : root.kind == BtnKind.subtle ? Theme.text-secondary
        : Theme.text;

    min-height: 32px;
    min-width: layout.min-width;
    border-radius: Theme.radius;
    accessible-role: button;
    accessible-label: root.text != "" ? root.text : root.tooltip;
    accessible-description: root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    background: root.kind == BtnKind.accent ? (!root.enabled ? Theme.control-disabled : root.down ? Theme.accent-pressed : root.hover ? Theme.accent-hover : Theme.accent)
        : root.kind == BtnKind.stop ? (root.down ? Theme.record-pressed : root.hover ? Theme.record-hover : Theme.record)
        : root.kind == BtnKind.subtle ? (root.down ? Theme.subtle-pressed : root.hover ? Theme.subtle-hover : transparent)
        : (!root.enabled ? Theme.control-disabled : root.down ? Theme.control-pressed : root.hover ? Theme.control-hover : Theme.control);
    border-width: root.kind == BtnKind.standard || (root.kind == BtnKind.subtle && root.danger) ? 1px : 0px;
    border-color: root.danger && root.hover ? Theme.critical : Theme.control-stroke;
    animate background, border-color { duration: 120ms; }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    fs := FocusScope {
        // Clicks belong to the TouchArea; this scope is only for Tab/keyboard focus.
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if fs.has-focus: FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; }

    layout := HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 8px;
        alignment: center;
        if root.has-icon: Image {
            source: root.icon;
            colorize: root.fg;
            width: root.icon-size;
            image-fit: contain;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: root.font-size;
            font-weight: root.font-weight;
            vertical-alignment: center;
        }
        if root.trailing != "": Rectangle { horizontal-stretch: 1; }
        if root.trailing != "": Text {
            text: root.trailing;
            color: root.fg;
            font-size: root.trailing-size;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.shortcut != "": Text {
            text: root.shortcut;
            color: root.fg.with-alpha(0.62);
            font-size: Theme.caption;
            vertical-alignment: center;
        }
    }
}

export component Card inherits Rectangle {
    in property <length> pad: 20px;
    in property <length> gap: 16px;
    vertical-stretch: 0;
    background: Theme.card-bg;
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Theme.card-stroke;
    VerticalLayout {
        padding: root.pad;
        spacing: root.gap;
        @children
    }
}

export component KeyCap inherits Rectangle {
    in property <string> text;
    background: Theme.control;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.control-stroke;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: Theme.control-stroke-bottom;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 2px;
        Text {
            text: root.text;
            font-size: Theme.caption;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}

component TabItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();

    border-radius: Theme.radius;
    background: ta.has-hover && root.enabled && !root.selected ? Theme.subtle-hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    fs := FocusScope {
        // Clicks belong to the TouchArea; this scope is only for Tab/keyboard focus.
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus: FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 12px;
        spacing: 8px;
        Image {
            source: root.icon;
            colorize: !root.enabled ? Theme.text-disabled : root.selected ? Theme.text : Theme.text-secondary;
            width: 18px;
            image-fit: contain;
        }
        Text {
            text: root.text;
            font-size: 15px;
            font-weight: root.selected ? 600 : 400;
            color: !root.enabled ? Theme.text-disabled : root.selected ? Theme.text : Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    Rectangle {
        width: root.selected ? 18px : 0px;
        height: 3px;
        y: root.height - 5px;
        border-radius: 1.5px;
        background: Theme.accent;
        animate width { duration: 160ms; easing: ease-out; }
    }
}

export component SourceTabs inherits HorizontalLayout {
    in property <int> selected;
    in property <bool> enabled: true;
    callback select(int);
    spacing: 4px;
    alignment: start;
    TabItem {
        icon: @image-url("icons/speaker.svg");
        text: "System audio";
        selected: root.selected == 0;
        enabled: root.enabled;
        clicked => { root.select(0); }
    }
    TabItem {
        icon: @image-url("icons/mic.svg");
        text: "Microphone";
        selected: root.selected == 1;
        enabled: root.enabled;
        clicked => { root.select(1); }
    }
}

component PopupRow inherits Rectangle {
    in property <string> text;
    in property <string> subtitle;
    in property <bool> selected;
    callback clicked();
    min-height: root.subtitle != "" ? 48px : 34px;
    border-radius: Theme.radius;
    background: ta.pressed ? Theme.subtle-pressed : ta.has-hover || root.selected ? Theme.subtle-hover : transparent;
    accessible-role: list-item;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    if root.selected: Rectangle {
        x: 0;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.text;
                color: Theme.text;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-secondary;
                font-size: Theme.caption;
                overflow: elide;
            }
        }
    }
}

component PopupPanel inherits Rectangle {
    background: Theme.popup-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.popup-stroke;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000055;
}

// Device picker: name plus a second line ("Everything this device plays", "Windows default").
export component DeviceDropdown inherits Rectangle {
    in property <[DeviceItem]> items;
    in property <int> selected: -1;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <string> placeholder: "No devices found";
    callback select(int);

    private property <bool> has-item: root.selected >= 0 && root.selected < root.items.length;
    height: 58px;
    border-radius: Theme.radius;
    background: !root.enabled ? Theme.control-disabled : ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.control-hover : Theme.control;
    border-width: 1px;
    border-color: Theme.control-stroke;
    accessible-role: combobox;
    accessible-label: "Device";
    accessible-value: root.has-item ? root.items[root.selected].name : root.placeholder;
    animate background { duration: 120ms; }

    ta := TouchArea {
        enabled: root.enabled && root.items.length > 0;
        clicked => { popup.show(); }
    }
    fs := FocusScope {
        // Clicks belong to the TouchArea; this scope is only for Tab/keyboard focus.
        focus-on-click: false;
        enabled: root.enabled && root.items.length > 0;
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" {
                popup.show();
                return accept;
            }
            if e.text == Key.DownArrow && root.selected < root.items.length - 1 {
                root.select(root.selected + 1);
                return accept;
            }
            if e.text == Key.UpArrow && root.selected > 0 {
                root.select(root.selected - 1);
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus: FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        Image {
            source: root.icon;
            colorize: root.enabled ? Theme.text : Theme.text-disabled;
            width: 20px;
            image-fit: contain;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.has-item ? root.items[root.selected].name : root.placeholder;
                color: root.enabled && root.has-item ? Theme.text : Theme.text-secondary;
                overflow: elide;
            }
            if root.has-item: Text {
                text: root.items[root.selected].subtitle;
                color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
                font-size: Theme.caption;
                overflow: elide;
            }
        }
        Image {
            source: @image-url("icons/chevron-down.svg");
            colorize: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            width: 14px;
            image-fit: contain;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: list.preferred-height;
        PopupPanel {
            list := VerticalLayout {
                padding: 4px;
                spacing: 2px;
                for item[i] in root.items: PopupRow {
                    text: item.name;
                    subtitle: item.subtitle;
                    selected: i == root.selected;
                    clicked => {
                        root.select(i);
                        popup.close();
                    }
                }
            }
        }
    }
}

export component Dropdown inherits Rectangle {
    in property <[string]> items;
    in property <int> selected;
    in property <bool> enabled: true;
    in property <string> label;
    callback select(int);

    height: 32px;
    min-width: 96px;
    border-radius: Theme.radius;
    background: !root.enabled ? Theme.control-disabled : ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.control-hover : Theme.control;
    border-width: 1px;
    border-color: Theme.control-stroke;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.selected >= 0 && root.selected < root.items.length ? root.items[root.selected] : "";
    animate background { duration: 120ms; }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }
    fs := FocusScope {
        // Clicks belong to the TouchArea; this scope is only for Tab/keyboard focus.
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" {
                popup.show();
                return accept;
            }
            if e.text == Key.DownArrow && root.selected < root.items.length - 1 {
                root.select(root.selected + 1);
                return accept;
            }
            if e.text == Key.UpArrow && root.selected > 0 {
                root.select(root.selected - 1);
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus: FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 8px;
        Text {
            text: root.selected >= 0 && root.selected < root.items.length ? root.items[root.selected] : "";
            color: root.enabled ? Theme.text : Theme.text-disabled;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Image {
            source: @image-url("icons/chevron-down.svg");
            colorize: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            width: 12px;
            image-fit: contain;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: plist.preferred-height;
        PopupPanel {
            plist := VerticalLayout {
                padding: 4px;
                spacing: 2px;
                for item[i] in root.items: PopupRow {
                    text: item;
                    selected: i == root.selected;
                    clicked => {
                        root.select(i);
                        popup.close();
                    }
                }
            }
        }
    }
}

// Two-option toggle (MP3 | WAV).
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> selected;
    in property <bool> enabled: true;
    in property <string> label;
    callback select(int);

    height: 32px;
    border-radius: Theme.radius;
    background: Theme.inset;
    border-width: 1px;
    border-color: Theme.control-stroke;
    accessible-role: tab-list;
    accessible-label: root.label;

    fs := FocusScope {
        // Clicks belong to the TouchArea; this scope is only for Tab/keyboard focus.
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.RightArrow && root.selected < root.items.length - 1 {
                root.select(root.selected + 1);
                return accept;
            }
            if e.text == Key.LeftArrow && root.selected > 0 {
                root.select(root.selected - 1);
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus: FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; }

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            border-radius: 3px;
            background: i == root.selected ? Theme.control : seg-ta.has-hover && root.enabled ? Theme.subtle-hover : transparent;
            border-width: i == root.selected ? 1px : 0px;
            border-color: Theme.control-stroke;
            accessible-role: tab;
            accessible-label: item;
            accessible-item-selected: i == root.selected;
            accessible-action-default => { root.select(i); }
            animate background { duration: 120ms; }
            seg-ta := TouchArea {
                enabled: root.enabled;
                clicked => { root.select(i); }
            }
            Text {
                text: item;
                font-weight: i == root.selected ? 600 : 400;
                color: !root.enabled ? Theme.text-disabled : i == root.selected ? Theme.text : Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if i == root.selected: Rectangle {
                y: parent.height - 4px;
                width: 14px;
                height: 2px;
                border-radius: 1px;
                background: Theme.accent;
            }
        }
    }
}

component MeterBar inherits Rectangle {
    in property <float> level;
    in property <float> hold;
    in property <bool> live;
    height: 8px;
    border-radius: 4px;
    background: Theme.inset;
    clip: true;
    // The gradient spans the whole scale so each colour stays anchored to its dB value.
    Rectangle {
        background: @linear-gradient(90deg, Theme.meter-green 0%, Theme.meter-green 76%, Theme.meter-yellow 88%, Theme.meter-red 98%);
        opacity: root.live ? 1 : 0.0;
    }
    Rectangle {
        x: root.width * root.level;
        width: root.width * (1 - root.level);
        background: Theme.inset;
    }
    if root.live && root.hold > 0.01: Rectangle {
        x: max(0px, root.width * root.hold - 2px);
        width: 2px;
        background: root.hold > 0.95 ? Theme.meter-red : root.hold > 0.85 ? Theme.meter-yellow : Theme.text.with-alpha(0.8);
    }
}

component Tick inherits Text {
    in property <float> pos;
    in property <length> track;
    x: max(0px, min(self.track - self.width, self.track * self.pos - self.width / 2));
    font-size: 11px;
    color: Theme.text-tertiary;
}

// Left/right peak meter on a −60…0 dB scale, with peak-hold lines.
export component LevelMeter inherits VerticalLayout {
    in property <float> left;
    in property <float> right;
    in property <float> hold-left;
    in property <float> hold-right;
    in property <bool> mono;
    in property <bool> live;
    spacing: 4px;
    accessible-role: progress-indicator;
    accessible-label: "Input level";

    MeterBar {
        level: root.left;
        hold: root.hold-left;
        live: root.live;
    }
    if !root.mono: MeterBar {
        level: root.right;
        hold: root.hold-right;
        live: root.live;
    }
    ticks := Rectangle {
        height: 14px;
        Tick { text: "-48"; pos: 0.2; track: ticks.width; }
        Tick { text: "-24"; pos: 0.6; track: ticks.width; }
        Tick { text: "-12"; pos: 0.8; track: ticks.width; }
        Tick { text: "-6"; pos: 0.9; track: ticks.width; }
        Tick { text: "0 dB"; pos: 1.0; track: ticks.width; }
    }
}

export component Spinner inherits Rectangle {
    width: 16px;
    height: 16px;
    Image {
        width: 16px;
        height: 16px;
        source: @image-url("icons/spinner.svg");
        colorize: Theme.accent;
        transform-rotation: mod(animation-tick() / 1ms, 900) * 0.4deg;
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value;
    height: 4px;
    border-radius: 2px;
    background: Theme.inset;
    Rectangle {
        x: 0;
        width: root.width * clamp(root.value, 0, 1);
        border-radius: 2px;
        background: Theme.accent;
        animate width { duration: 120ms; }
    }
}

global Severity {
    public pure function icon(s: int) -> image {
        return s == 1 ? @image-url("icons/success.svg") : s == 2 ? @image-url("icons/warning.svg") : s == 3 ? @image-url("icons/error.svg") : @image-url("icons/info.svg");
    }
    public pure function tint(s: int) -> color {
        return s == 1 ? Theme.success : s == 2 ? Theme.caution : s == 3 ? Theme.critical : Theme.accent;
    }
}

// WinUI-style InfoBar.
export component Banner inherits Rectangle {
    in property <NoticeData> data;
    callback action();
    callback secondary();
    callback dismiss();

    vertical-stretch: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.card-stroke;
    background: root.data.severity == 1 ? Theme.success-bg : root.data.severity == 2 ? Theme.caution-bg : root.data.severity == 3 ? Theme.critical-bg : Theme.info-bg;
    accessible-role: text;
    accessible-label: root.data.title + ". " + root.data.message;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            padding-top: 2px;
            alignment: start;
            Image {
                source: Severity.icon(root.data.severity);
                colorize: Severity.tint(root.data.severity);
                width: 16px;
                height: 16px;
            }
        }
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.data.title;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.data.message != "": Text {
                text: root.data.message;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
        if root.data.action-text != "" || root.data.secondary-text != "": VerticalLayout {
            alignment: center;
            HorizontalLayout {
            spacing: 8px;
            if root.data.action-text != "": Btn {
                text: root.data.action-text;
                kind: root.data.secondary-text != "" ? BtnKind.accent : BtnKind.standard;
                clicked => { root.action(); }
            }
            if root.data.secondary-text != "": Btn {
                text: root.data.secondary-text;
                clicked => { root.secondary(); }
            }
            }
        }
        if root.data.closable: VerticalLayout {
            alignment: center;
            Btn {
                icon: @image-url("icons/close.svg");
                kind: BtnKind.subtle;
                pad: 8px;
                icon-size: 14px;
                tooltip: "Dismiss";
                clicked => { root.dismiss(); }
            }
        }
    }
}

// Result message under the export buttons: title, then details.
export component StatusLine inherits HorizontalLayout {
    in property <NoticeData> data;
    callback action();
    callback dismiss();
    spacing: 10px;
    accessible-role: text;
    accessible-label: root.data.title + ". " + root.data.message;
    VerticalLayout {
        padding-top: 2px;
        alignment: start;
        Image {
            source: Severity.icon(root.data.severity);
            colorize: Severity.tint(root.data.severity);
            width: 16px;
            height: 16px;
        }
    }
    VerticalLayout {
        spacing: 1px;
        horizontal-stretch: 1;
        alignment: center;
        Text {
            text: root.data.title;
            color: Theme.text;
            font-weight: 600;
            overflow: elide;
        }
        if root.data.message != "": Text {
            text: root.data.message;
            font-size: Theme.caption;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
    if root.data.action-text != "": VerticalLayout {
        alignment: center;
        Btn {
            text: root.data.action-text;
            kind: BtnKind.standard;
            clicked => { root.action(); }
        }
    }
}
